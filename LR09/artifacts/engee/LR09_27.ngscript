    {
      "id": "lr09-v27-01",
      "cell_type": "code",
      "source": [
        "# Шаги 4–6 плана. Вариант 27: серия A и B на seed 101…105, сводка, проверки. Запуск блокирующий\n# (фоновый запуск из ячейки подвешивает ячейку). Если results_v27.json уже есть, повторно не запускается.\ncmd = addenv(Cmd(`$PY -u $(joinpath(W, \"lr09_variant27.py\"))`; dir = W), \"LR09_ENGEE_VERSION\"=>ENGEE_VERSION, \"LR09_JULIA_VERSION\"=>string(VERSION))\nif isfile(joinpath(W, \"results_v27.json\"))\n    println(\"результат уже есть: results_v27.json от \", Dates.unix2datetime(mtime(joinpath(W, \"results_v27.json\"))), \" UTC — повторно не запускаю\")\nelse\n    t0 = time(); run(pipeline(cmd; stdin = devnull, stdout = joinpath(W, \"out_v27.txt\"), stderr = joinpath(W, \"err_v27.txt\")))\n    println(\"вариант 27 выполнен за \", round((time() - t0) / 60; digits = 1), \" мин; stderr: \", filesize(joinpath(W, \"err_v27.txt\")), \" байт\")\nend"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "вариант 27 выполнен за 6.1 мин; stderr: 1693 байт\n"
        }
      ],
