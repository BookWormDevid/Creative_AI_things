            "scrollTop": 0
          },
          "maskInfo": {
            "isMaskVisible": true,
            "isEditorVisible": true,
            "isAutoplayActive": false
          }
        }
      }
    },
    {
      "id": "48f8b232",
      "cell_type": "code",
      "source": [
        "# Шаг 5. Контрольная сумма яркости при seed 101 — дважды\ncd(\"/user/Котов_Дэвид_Арсенович/LR03\")\nsha_1 = array_sha(luma_images(make_scene(101; P...)))\nsha_2 = array_sha(luma_images(make_scene(101; P...)))\nsha_ctrl = array_sha(luma_images(make_scene(102; P...)))\nprintln(\"seed 101, построение 1: \", sha_1)\nprintln(\"seed 101, построение 2: \", sha_2)\nprintln(\"совпадение: \", sha_1 == sha_2)\nprintln(\"контроль, seed 102:     \", sha_ctrl[1:16], \"  (отличается: \", sha_ctrl != sha_1, \")\")\n\n"
      ],
      "execution_count": 0,
      "outputs": [],
      "metadata": {
        "name": "Название секции",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
