    {
      "id": "lr10-v27-01",
      "cell_type": "code",
      "source": [
        "# variant_summary(27, save_dir=\"v27\") и blind_sheets(27, \"v27\"). Запуск блокирующий\n# (фоновый запуск из ячейки подвешивает ячейку). Если results_v27.json уже есть, повторно не запускается.\ncmd = addenv(Cmd(`$PY -u $(joinpath(W, \"lr10_variant27.py\"))`; dir = W), \"LR10_ENGEE_VERSION\"=>ENGEE_VERSION, \"LR10_JULIA_VERSION\"=>string(VERSION))\nif isfile(joinpath(W, \"results_v27.json\"))\n    println(\"результат уже есть: results_v27.json от \", Dates.unix2datetime(mtime(joinpath(W, \"results_v27.json\"))), \" UTC — повторно не запускаю\")\nelse\n    t0 = time(); run(pipeline(cmd; stdin = devnull, stdout = joinpath(W, \"out_v27.txt\"), stderr = joinpath(W, \"err_v27.txt\")))\n    println(\"вариант 27 выполнен за \", round((time() - t0) / 60; digits = 1), \" мин; stderr: \", filesize(joinpath(W, \"err_v27.txt\")), \" байт\")\nend"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "результат уже есть: results_v27.json от 2026-11-04T14:09:22.953 UTC — повторно не запускаю\n"
        }
      ],
