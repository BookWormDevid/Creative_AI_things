  "cells": [
    {
      "id": "6560f7cb",
      "cell_type": "code",
      "source": [
        "# ЛР №3, вариант 27. Котов Дэвид Арсенович.\n# Сцена 5 «шахматная структура» (lo 0,15, hi 0,85, шум 0,02, checker 8) × воздействие 3 «уменьшение в 4 раза и возврат».\n# Скрипт для Engee. Одна ячейка — один шаг плана методических указаний (раздел 5).\n# Шаг 2 (гипотеза и допуск до запуска) выполнен в журнале LR03/reports/journal.md.\n\n# Шаг 1. Подготовка среды: дата, версия Julia, рабочая папка, учебная библиотека\nusing Dates, SHA\nprintln(\"Дата и время (UTC): \", now(UTC))\nprintln(\"VERSION = \", VERSION)\ncd(\"/user/Котов_Дэвид_Арсенович/LR03\")\nprintln(\"Рабочая папка: LR03\")\nlib = \"lab03_lib.jl\"\nprintln(\"lab03_lib.jl: \", filesize(lib), \" байт, SHA-256 = \", bytes2hex(open(sha256, lib)))\nprintln(\"совпадает с методичкой (cd1622643e7cfe7c…): \", startswith(bytes2hex(open(sha256, lib)), \"cd1622643e7cfe7c\"))\ninclude(lib)\nmake_scene(101) |> describe_image\n\n"
      ],
      "execution_count": 0,
      "outputs": [],
      "metadata": {
        "name": " ",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
          "isClosedParagraph": false,
          "amountHideCellsInside": 0,
          "codeOutputView": "col",
          "codeOutputHidden": false,
          "outputInfo": {
            "isExpanded": false,
            "scrollTop": 0
