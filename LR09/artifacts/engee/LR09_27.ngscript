  "cells": [
    {
      "id": "lr09-v27-00",
      "cell_type": "code",
      "source": [
        "# Шаг 3 плана. Среда: дата, версии, файлы работы и их SHA-256; пакеты указаний\n",
        "using Dates, SHA\n",
        "W = \"/user/Котов_Дэвид_Арсенович/LR09\"\n",
        "PY = \"/user/.user_venvs/py3.11/bin/python3\"\n",
        "ENGEE_VERSION = \"\"  # Вписать текущую версию из заголовка Engee.\n",
        "println(\"Дата и время (UTC): \", now(UTC))\n",
        "println(\"Julia VERSION = \", VERSION, \";  ядер: \", Sys.CPU_THREADS, \";  ОЗУ: \", round(Sys.total_memory() / 2^30; digits = 1), \" ГБ\")\n",
        "for (f, ref) in ((\"lab09_lib.py\", \"cc4d233d\"), (\"lab09_llm.py\", \"5eabb31f\"), (\"run_lr09.py\", \"a962a37b\"), (\"lr09_variant27.py\", \"\"))\n",
        "    isfile(joinpath(W,f)) || error(\"В папке LR09 отсутствует \" * f * \"; загрузите все файлы из архива.\")\n",
        "    h = bytes2hex(open(sha256, joinpath(W, f)))\n",
        "    println(rpad(f, 18), filesize(joinpath(W, f)), \" байт, SHA-256 \", h, isempty(ref) ? \"\" : \"; совпадает с архивом работы: $(startswith(h, ref))\")\n",
        "end\n",
        "# Раздел 4 указаний: diffusers 0.32.2 и transformers < 5, PyTorch не обновлять. Если torch в окружении нет\n",
        "# (так было в ЛР 8), ставится версия указаний — 2.4.1 для процессора. Вывод pip — в pip_install.log.\n",
        "has(m) = success(ignorestatus(`$PY -c \"import $m\"`))\n",
        "PIPLOG = joinpath(W, \"pip_install.log\")\n",
        "pipi(args...) = run(pipeline(`$PY -m pip install --progress-bar off $args`; stdin = devnull, stdout = PIPLOG, stderr = PIPLOG, append = true))\n",
        "has(\"torch\") || (println(\"ставлю torch 2.4.1 (CPU)\"); pipi(\"torch==2.4.1\", \"--index-url\", \"https://download.pytorch.org/whl/cpu\"))\n",
        "has(\"scipy\") || (println(\"ставлю scipy\"); pipi(\"scipy\"))\n",
        "ver = read(ignorestatus(`$PY -c \"import diffusers, transformers; print(diffusers.__version__, transformers.__version__)\"`), String)\n",
        "# Команда указаний (\"transformers<5\") не обновляет уже стоящую версию 4.x (в окружении была 4.48.3), поэтому\n",
        "# ставится проверенная указаниями 4.57.6.\n",
        "startswith(ver, \"0.32.2 4.57.\") || (println(\"ставлю diffusers==0.32.2, transformers==4.57.6\"); pipi(\"diffusers==0.32.2\", \"transformers==4.57.6\"))\n",
        "run(`$PY -c \"import sys, torch, diffusers, transformers, scipy, numpy; print('python', sys.version.split()[0], '| torch', torch.__version__, '| diffusers', diffusers.__version__, '| transformers', transformers.__version__, '| scipy', scipy.__version__, '| numpy', numpy.__version__, '| cuda', torch.cuda.is_available())\"`)"
      ],
      "metadata": {},
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "lr09-v27-01",
      "cell_type": "code",
      "source": [
        "# Шаги 4–6 плана. Вариант 27: серия A и B на seed 101…105, сводка, проверки. Запуск блокирующий\n",
        "# (фоновый запуск из ячейки подвешивает ячейку). Если results_v27.json уже есть, повторно не запускается.\n",
        "cmd = addenv(Cmd(`$PY -u $(joinpath(W, \"lr09_variant27.py\"))`; dir = W), \"LR09_ENGEE_VERSION\"=>ENGEE_VERSION, \"LR09_JULIA_VERSION\"=>string(VERSION))\n",
        "if isfile(joinpath(W, \"results_v27.json\"))\n",
        "    println(\"результат уже есть: results_v27.json от \", Dates.unix2datetime(mtime(joinpath(W, \"results_v27.json\"))), \" UTC — повторно не запускаю\")\n",
        "else\n",
        "    t0 = time(); run(pipeline(cmd; stdin = devnull, stdout = joinpath(W, \"out_v27.txt\"), stderr = joinpath(W, \"err_v27.txt\")))\n",
        "    println(\"вариант 27 выполнен за \", round((time() - t0) / 60; digits = 1), \" мин; stderr: \", filesize(joinpath(W, \"err_v27.txt\")), \" байт\")\n",
        "end"
      ],
      "metadata": {},
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "lr09-v27-02",
      "cell_type": "code",
      "source": [
        "# Вывод скрипта варианта целиком\n",
        "print(read(joinpath(W, \"out_v27.txt\"), String))"
      ],
      "metadata": {},
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "lr09-v27-03",
      "cell_type": "code",
      "source": [
        "# Шаг 5 плана. Лист сравнения seed 101: слева A, справа B\n",
        "using Images\n",
        "hcat(load(joinpath(W, \"v27\", \"A_s101.png\")), load(joinpath(W, \"v27\", \"B_s101.png\")))"
      ],
      "metadata": {},
      "execution_count": null,
      "outputs": []
    },
    {
      "id": "lr09-v27-04",
      "cell_type": "code",
      "source": [
        "# Шаг 7 плана. Запросы части 2 для новых чатов языковой модели (контекст 5)\n",
        "for a in (\"zero\", \"few\", \"step\")\n",
        "    println(\"=== \", a, \" ===\")\n",
        "    run(Cmd(`$PY $(joinpath(W, \"lab09_llm.py\")) prompt $a 5`; dir = W))\n",
        "end"
      ],
      "metadata": {},
      "execution_count": null,
      "outputs": []
    }
  ]
}
