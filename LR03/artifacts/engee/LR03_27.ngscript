    },
    {
      "id": "53e40027",
      "cell_type": "code",
      "source": [
        "# Шаг 6. Гистограмма яркости до воздействия (32 интервала) и сохранение графика\ncd(\"/user/Котов_Дэвид_Арсенович/LR03\")\nusing Plots\ng = luma_images(img)\ncb = hist_counts(g, 32)\nxc = ((1:32) .- 0.5) ./ 32\nhb = bar(xc, cb; bar_width = 1 / 32, legend = false, size = (560, 380),\n         title = \"Before: scene 5, seed 101\", xlabel = \"luminance\", ylabel = \"count\")\nsavefig(hb, \"v27_hist_before.png\")\nprintln(\"сохранено: v27_hist_before.png;  занятых интервалов: \", count(>(0), cb), \" из 32\")\nhb\n\n"
      ],
      "execution_count": 0,
      "outputs": [],
      "metadata": {
        "name": "Название секции",
        "engee": {
