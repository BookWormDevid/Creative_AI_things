    {
      "id": "0b918ac3",
      "cell_type": "code",
      "source": [
        "# Продвинутый уровень рубрики: воспроизведение демонстрационного варианта 1 и сверка с методичкой\ncd(\"/user/Котов_Дэвид_Арсенович/LR03\")\nD = variant_summary(1)\nsha_demo = array_sha(luma_images(make_scene(101)))[1:16]\nprintln(\"демо PSNR = \", D.psnr, \"   в методичке 34.594244830067446   совпало: \", D.psnr == 34.594244830067446)\nprintln(\"демо SHA  = \", sha_demo, \"   в методичке 50567c6b9e5e4ac1   совпало: \", sha_demo == \"50567c6b9e5e4ac1\")\nfor (m, b, s, a, dd, r, sig) in D.rows\n    println(\"  \", rpad(string(m), 9), \"база = \", b, \"  после = \", a, \"  |Δ|/s = \", round(r; digits = 3))\nend\n\n"
      ],
      "execution_count": 0,
      "outputs": [],
      "metadata": {
        "name": "Название секции",
        "engee": {
