            "isMaskVisible": true,
            "isEditorVisible": true,
            "isAutoplayActive": false
          }
        }
      }
    },
    {
      "id": "1c863843",
      "cell_type": "code",
      "source": [
        "# Шаг 3. Сцена варианта и её свойства: размер, тип, диапазон, объём в байтах\ncd(\"/user/Котов_Дэвид_Арсенович/LR03\")\nVARIANT = 27\nSCENE, FACTOR = divrem(VARIANT - 1, 6) .+ 1\nP = scene_preset(SCENE)\nimg = make_scene(101; P...)\nd = describe_image(img)\nprintln(\"вариант \", VARIANT, \": сцена \", SCENE, \", воздействие \", FACTOR)\nprintln(\"параметры сцены: \", P)\nprintln(\"size = \", d.size, \", eltype = \", d.eltype)\nprintln(\"min = \", d.min, \", max = \", d.max)\nprintln(\"bytes = \", d.bytes, \"  (ожидалось 128·128·3·8 = \", 128 * 128 * 3 * 8, \")\")\n\n"
      ],
      "execution_count": 0,
      "outputs": [],
      "metadata": {
        "name": "Название секции",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
          "isClosedParagraph": false,
          "amountHideCellsInside": 0,
          "codeOutputView": "col",
          "codeOutputHidden": false,
          "outputInfo": {
            "isExpanded": false,
            "scrollTop": 0
          },
          "maskInfo": {
            "isMaskVisible": true,
            "isEditorVisible": true,
            "isAutoplayActive": false
          }
        }
      }
    },
    {
      "id": "02431aaa",
      "cell_type": "code",
      "source": [
        "# Шаг 4. Яркость двумя способами и максимум модуля разности\ncd(\"/user/Котов_Дэвид_Арсенович/LR03\")\ny_manual = luma_manual(img)\ny_gray = luma_images(img)\nprintln(\"максимум модуля разности = \", maximum(abs.(y_manual .- y_gray)))\nprintln(\"сравнение с допуском isapprox: \", isapprox(y_manual, y_gray))\nprintln(\"SHA вручную: \", array_sha(y_manual)[1:16])\nprintln(\"SHA Gray:    \", array_sha(y_gray)[1:16])\nprintln(\"контрольные суммы равны: \", array_sha(y_manual) == array_sha(y_gray))\n\n"
      ],
      "execution_count": 0,
      "outputs": [],
      "metadata": {
        "name": "Название секции",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
          "isClosedParagraph": false,
          "amountHideCellsInside": 0,
          "codeOutputView": "col",
          "codeOutputHidden": false,
          "outputInfo": {
